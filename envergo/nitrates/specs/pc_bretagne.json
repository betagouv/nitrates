  {
    "identifiant": "pc_bzh_derobees",
    "variante_de": null,
    "scope": "region",
    "region_code": "53",
    "plafond": false,
    "mots_cles": "dérobées GREN Bretagne",
    "blocs": {
      "blocs": [
        {
          "data": {
            "texte": "Fertilisation des dérobées en Bretagne"
          },
          "type": "titre_principal"
        },
        {
          "data": {
            "texte": "Le principe"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "L'arrêté régional d'équilibre de la fertilisation azotée (GREN) limite la fertilisation des dérobées à un seul des deux mois d'été, sans possibilité de cumul."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Ce qui est possible"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "items": [
              {
                "texte": "En juillet : 50 kg d'azote par hectare au maximum"
              },
              {
                "texte": "Ou en août : 40 kg d'azote par hectare au maximum"
              },
              {
                "texte": "En septembre : seulement des effluents peu chargés (moins de 0,5 kg d'azote par m³), dans la limite de 20 kg d'azote efficace par hectare"
              }
            ]
          },
          "type": "liste"
        },
        {
          "data": {
            "texte": "Ce qui est interdit"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Tout apport de fertilisant sur dérobée est interdit en octobre, novembre et décembre."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Référence"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "PAR Bretagne modifié (arrêté préfectoral régional du 28/08/2026), annexe 6, note (1) ; arrêté GREN Bretagne du 29/03/2023."
          },
          "type": "paragraphe"
        }
      ],
      "schema": 1
    }
  },
