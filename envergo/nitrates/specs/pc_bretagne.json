        },
        {
          "data": {
            "texte": "Le principe"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Sur culture de printemps, l'épandage d'effluents liquides peu chargés issus d'un traitement d'effluents bruts est possible jusqu'au 31 août, dans la limite d'une dose maximale."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Les effluents concernés"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Effluents liquides peu chargés issus d'un traitement d'effluents bruts, contenant moins de 0,5 kg d'azote par m³."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "La dose maximale"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": [
              {
                "texte": "La dose maximale est de "
              },
              {
                "gras": true,
                "texte": "50 kg d'azote efficace par hectare"
              },
              {
                "texte": ", jusqu'au 31 août."
              }
            ]
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Référence"
          },
          "type": "titre_paragraphe"
