          "data": {
            "texte": "Sur prairie implantée depuis plus de six mois (dont prairie permanente et luzerne), l'épandage d'effluents peu chargés issus d'un traitement d'effluents bruts est possible pendant la période d'interdiction, dans la limite d'une dose maximale et dans le respect des autres règles d'épandage."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Les effluents concernés"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Effluents peu chargés issus d'un traitement d'effluents bruts, contenant moins de 0,5 kg d'azote par m³."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "La dose maximale"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": [
              {
                "texte": "La dose maximale est de "
              },
              {
                "gras": true,
                "texte": "20 kg d'azote efficace par hectare"
              },
              {
                "texte": " sur la période d'interdiction."
              }
            ]
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Référence"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "PAR Bretagne modifié (arrêté préfectoral régional du 28/08/2026), annexe 6, note (3)."
