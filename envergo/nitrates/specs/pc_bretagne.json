          "data": {
            "items": [
              {
                "texte": "Pluviométrie des 15 jours précédant la décision (stations Météo-France)"
              },
              {
                "texte": "Pluviométrie prévisionnelle des 12 jours à venir"
              }
            ]
          },
          "type": "liste"
        },
