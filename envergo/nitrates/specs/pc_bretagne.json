            "texte": "Fertilisation des couverts non exportés en Bretagne"
          },
          "type": "titre_principal"
        },
        {
          "data": {
            "texte": "Le principe"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Toute fertilisation d'un couvert d'interculture non exporté (CINE) est interdite."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "La seule exception"
          },
          "type": "titre_paragraphe"
        },
        {
          "data": {
            "texte": "Les apports de fertilisants de type I destinés à la culture suivante sont autorisés à partir du 15 janvier."
          },
          "type": "paragraphe"
        },
        {
          "data": {
            "texte": "Référence"
          },
